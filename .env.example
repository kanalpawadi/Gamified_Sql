# Supabase — client-side config (public values; RLS is the security boundary).
# Find these in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI grading for Internal Tests — SERVER-SIDE ONLY (no VITE_ prefix, so it is
# never bundled into the browser). Set these in Vercel → Project → Settings →
# Environment Variables. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional: override the model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
